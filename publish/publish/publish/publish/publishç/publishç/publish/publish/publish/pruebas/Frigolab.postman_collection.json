    {
      "name": "2 · Trazabilidad con la fecha del formulario",
      "item": [
        {
          "name": "2.1 Lotes de los últimos 60 días",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si la base que se esta probando no tiene datos recientes (una copia de",
                  "// desarrollo, por ejemplo), se le pasa un rango con las variables",
                  "// `desde` y `hasta`. Vacias = los ultimos 60 dias.",
                  "const desde = pm.variables.get('desde');",
                  "const hasta = pm.variables.get('hasta');",
                  "if (desde) pm.request.url.addQueryParams(['from=' + desde]);",
                  "if (hasta) pm.request.url.addQueryParams(['to=' + hasta]);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const lotes = (j.lotes && j.lotes.$values) || j.lotes || [];",
                  "pm.test('devuelve lotes (si falla, la base no tiene datos en el rango: usar las variables desde/hasta)', () => pm.expect(lotes.length).to.be.above(0));",
                  "if (lotes.length === 0) { console.log('Sin lotes en el rango. Poner las variables desde/hasta, ej: desde=2026-04-01 hasta=2026-06-01'); return; }",
                  "pm.test('cada lote trae primera y última fecha', () => {",
                  "  pm.expect(lotes.every(l => /^\\d{4}-\\d{2}-\\d{2}$/.test(String(l.first_date)))).to.be.true;",
                  "  pm.expect(lotes.every(l => /^\\d{4}-\\d{2}-\\d{2}$/.test(String(l.last_date)))).to.be.true;",
                  "});",
                  "// Se guarda uno real para el siguiente pedido: asi la prueba sirve en",
                  "// cualquier servidor sin tener que escribir un numero de lote a mano.",
                  "const conVarios = lotes.find(l => Number(l.count) > 1) || lotes[0];",
                  "pm.collectionVariables.set('loteReal', String(conVarios.lote));",
                  "console.log('Lote elegido para el detalle: ' + conVarios.lote + ' (' + conVarios.count + ' formularios)');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/Traceability/lotes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Traceability",
                "lotes"
              ]
            }
          }
        },
        {
          "name": "2.2 Detalle: cada paso trae la fecha que escribió el operario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hayLote = !!pm.collectionVariables.get('loteReal');",
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "if (!hayLote) { console.log('Se saltea: el pedido anterior no encontro ningun lote.'); return; }",
                  "const j = pm.response.json();",
                  "const pasos = (j.pasos && j.pasos.$values) || j.pasos || [];",
                  "pm.test('el lote tiene pasos', () => pm.expect(pasos.length).to.be.above(0));",
                  "pm.test('todos traen fecha_registro  ← el arreglo', () => {",
                  "  pm.expect(pasos.every(p => /^\\d{4}-\\d{2}-\\d{2}$/.test(String(p.fecha_registro)))).to.be.true;",
                  "});",
                  "pm.test('created_at se conserva como sello de auditoría', () => {",
                  "  pm.expect(pasos.every(p => !!p.created_at)).to.be.true;",
                  "});",
                  "const distintos = pasos.filter(p => String(p.fecha_registro) !== String(p.created_at).slice(0, 10));",
                  "console.log('Pasos con fecha de operario distinta a la de guardado: ' + distintos.length + ' de ' + pasos.length);",
                  "distintos.forEach(p => console.log('   form ' + p.form_id + ' · ' + p.template_codigo + ' · escribió ' + p.fecha_registro + ' · se guardó ' + String(p.created_at).slice(0, 10)));"
                ]
              }
            }
          ],
