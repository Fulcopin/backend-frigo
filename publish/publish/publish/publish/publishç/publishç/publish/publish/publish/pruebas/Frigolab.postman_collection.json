                  "const sello = Date.now();",
                  "pm.collectionVariables.set('lote', 'TEST-' + sello);",
                  "pm.collectionVariables.set('formA', 900000 + (sello % 10000));",
                  "pm.collectionVariables.set('formB', 910000 + (sello % 10000));"
