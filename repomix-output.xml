      "headerFields": [...],
      "bodyElements": [...],
      "firmas": [...]
    }
  },
  "data": {
    "header": { "Fecha": "2025-01-15", ... },
    "body": [ { "rows": [...] } ],
    "firmas": { "ASISTENTE": "Juan Pérez" }
  },
  "observaciones": "Todo correcto",
  "isHistorical": false
}
```

## ✅ Checklist de Implementación

