            _logger.LogInformation("  🔍 Puesto {Puesto}: Usuario asignado = {Name} ({Email})", puesto, targetName ?? "Sin nombre", targetEmail);

            // Verificar si este puesto ya tiene firma digital (imagen)
            bool yaFirmo = false;
