                        {
                            html += $"<div class='data-item'><span class='label'>{System.Net.WebUtility.HtmlEncode(item.Key)}:</span> <span class='value'>{System.Net.WebUtility.HtmlEncode(item.Value?.ToString() ?? "-")}</span></div>";
                        }
                        html += "</div>";
                    }
                    html += "</div>";
